# Copy to config/application-local.properties (git-ignored) and fill in. Loaded only with profile "local" (bootRun uses it), never by tests.
spring.datasource.url=jdbc:postgresql://localhost:5432/pos
spring.datasource.username=pos_app
spring.datasource.password=CHANGE_ME
# demo catalog + sale menu (dev only)
spring.flyway.locations=classpath:db/migration,classpath:db/master,classpath:db/demo
# config sync from the admin app (empty = stand-alone till)
pos.sync.admin-url=http://127.0.0.1:8081
pos.sync.terminal-token=dev-terminal-token
